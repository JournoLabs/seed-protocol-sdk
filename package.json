{
  "name": "seed-protocol-sdk-monorepo",
  "version": "0.7.10",
  "author": "Keith Axline <keith@journodao.xyz>",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@seedprotocol/vite": "workspace:*",
    "@tanstack/query-core": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/debug": "^4.1.12",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.13",
    "@types/lodash-es": "^4.17.12",
    "@types/nanoid-dictionary": "^4.2.3",
    "@types/node": "^24.10.1",
    "@types/path-browserify": "^1.0.3",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.1.0",
    "knip": "^6.43.0",
    "parse5": "8.0.1",
    "playwright": "^1.57.0",
    "prettier": "^3.7.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.0",
    "vite-plugin-inspect": "^11.3.3",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "description": "Seed Protocol SDK monorepo",
  "engines": {
    "node": ">= 20 <= 24"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/with-monorepo-build-lock.js \"node scripts/build-packages.js bundler-core eas arweave query vite sdk\"",
    "build:all": "node scripts/build-with-tests.js \"bun run sync-versions && node scripts/build-packages.js\"",
    "test": "node scripts/test-all.js",
    "test:watch": "vitest",
    "test:scripts": "node --test 'scripts/__tests__/*.test.js'",
    "ci:local": "node scripts/ci-local.js",
    "lint": "eslint .",
    "prettier": "prettier --config .prettierrc --write .",
    "codegen": "bun run --filter @seedprotocol/eas codegen && bun run --filter @seedprotocol/arweave codegen",
    "sync-versions": "node scripts/sync-versions.js",
    "new-version": "node scripts/new-version.js",
    "release": "node scripts/release.js",
    "publish:all": "node scripts/publish-package.js",
    "drizzle:update": "bun scripts/update-drizzle.ts"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ]
}
