{
  "name": "@seedprotocol/webpack",
  "version": "0.5.1",
  "private": true,
  "description": "Experimental — not supported; do not depend on or publish. Prefer withSeed from @seedprotocol/sdk/node.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && vite build",
    "test": "vitest run --reporter=default"
  },
  "peerDependencies": {
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@zenfs/core": {
      "optional": true
    },
    "path-browserify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT"
}
