{
  "name": "@seedprotocol/encryption",
  "version": "0.8.1",
  "private": true,
  "description": "Encryption for Seed Protocol private Versions: the seed-private/v1 envelope format and entitlement adapters",
  "keywords": [
    "seed-protocol",
    "encryption",
    "envelope",
    "private-publish"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "SPEC.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && vite build && node ../../scripts/fix-dts-specifiers.js",
    "test": "vitest run --reporter=default"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JournoLabs/seed-protocol-sdk.git",
    "directory": "packages/encryption"
  },
  "homepage": "https://github.com/JournoLabs/seed-protocol-sdk/tree/main/packages/encryption#readme",
  "bugs": {
    "url": "https://github.com/JournoLabs/seed-protocol-sdk/issues"
  }
}
