{
  "name": "@seedprotocol/sdk",
  "version": "0.5.1",
  "description": "The SDK for Seed Protocol",
  "type": "module",
  "main": "./dist/main.cjs",
  "module": "./dist/main.js",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">= 20 <= 24"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-with-tests.js \"tsc -p packages/sdk/tsconfig.declarations.json && node scripts/rewrite-dts-alias-to-relative.js\"",
    "build:watch": "tsc -w -p tsconfig.json",
    "build:dev": "node ../../scripts/build-with-tests.js \"cd packages/sdk && rm -rf dist && NODE_ENV=production rollup -c && node ../../scripts/check-dist-fragile-dynamic-imports.js --fail && node ../../scripts/check-dist-fragile-imports.js --fail && tsc -p tsconfig.declarations.json && node ../../scripts/rewrite-dts-alias-to-relative.js && node ../../scripts/check-dist-no-alias.js\"",
    "build:publish": "node ../../scripts/build-with-tests.js \"bun run sync-versions && cd packages/sdk && rm -rf dist && NODE_ENV=production rollup -c && node ../../scripts/check-dist-fragile-dynamic-imports.js --fail && node ../../scripts/check-dist-fragile-imports.js --fail && tsc -p tsconfig.declarations.json && node ../../scripts/rewrite-dts-alias-to-relative.js && node ../../scripts/check-dist-no-alias.js\"",
    "compile": "graphql-codegen --config codegen.ts",
    "watch": "graphql-codegen -w",
    "test": "vitest run --reporter=default",
    "test:ui": "vitest --ui --reporter=default",
    "test:watch": "vitest",
    "test:browser": "vitest --project=browser"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT",
  "optionalDependencies": {
    "@tanstack/query-sync-storage-persister": "5.90.15",
    "@tanstack/react-query": "^5.90.15",
    "@tanstack/react-query-persist-client": "5.90.15",
    "@zenfs/core": "2.5.6",
    "@zenfs/dom": "1.2.9",
    "fsevents": "^2.3.3"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.90.15",
    "drizzle-orm": "^0.44.3",
    "xstate": "^5.28.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "dependencies": {
    "@ethereum-attestation-service/eas-sdk": "^2.9.0",
    "@libsql/client": "^0.15.15",
    "@seedprotocol/arweave": "workspace:*",
    "@seedprotocol/eas": "workspace:*",
    "@seedprotocol/query": "workspace:*",
    "@seedprotocol/vite": "workspace:*",
    "@sinclair/typebox": "^0.34.45",
    "@sqlite.org/sqlite-wasm": "^3.51.1-build2",
    "arweave": "^1.15.5",
    "debug": "^4.4.1",
    "graphql-request": "^7.3.5",
    "immer": "^11.0.1",
    "js-sha3": "^0.9.3",
    "js-yaml": "^4.1.1",
    "lodash-es": "^4.17.22",
    "nanoid": "^5.1.5",
    "nanoid-dictionary": "^5.0.0",
    "parse5": "^8.0.0",
    "pluralize": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlocal": "^0.16.0",
    "tslib": "^2.8.1"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/main.js"
      },
      "require": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/main.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/src/node/index.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/src/node/index.d.ts",
        "default": "./dist/main.cjs"
      }
    },
    "./platform": {
      "browser": {
        "types": "./dist/src/platform/index.browser.d.ts",
        "default": "./dist/platform.browser.js"
      },
      "node": {
        "types": "./dist/src/platform/index.node.d.ts",
        "default": "./dist/platform.node.js"
      },
      "import": {
        "types": "./dist/src/platform/index.d.ts",
        "default": "./dist/platform.node.js"
      },
      "default": "./dist/platform.node.js"
    },
    "./vite": {
      "import": {
        "types": "./dist/src/vite/index.d.ts",
        "default": "./dist/vite.js"
      },
      "require": {
        "types": "./dist/src/vite/index.d.ts",
        "default": "./dist/vite.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.44.3",
    "eventemitter3": "^5.0.1",
    "kerium": "1.3.4",
    "magic-string": "^0.30.21",
    "memium": "0.3.10",
    "path-browserify": "^1.0.1",
    "readable-stream": "4.5.2",
    "rollup": "^4.53.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-tsconfig-paths": "^1.5.2",
    "typescript": "~5.9.3",
    "utilium": "2.5.0",
    "xstate": "^5.28.0"
  },
  "_bundleHint": {
    "note": "If bundling this package, mark the following as external: fsevents, better-sqlite3, and other native Node.js modules."
  }
}
