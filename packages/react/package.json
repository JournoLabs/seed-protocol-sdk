{
  "name": "@seedprotocol/react",
  "version": "0.7.11",
  "description": "React hooks and components for Seed Protocol: live schemas, models, items and properties from @seedprotocol/sdk, backed by TanStack Query",
  "keywords": [
    "seed-protocol",
    "react",
    "react-hooks",
    "local-first",
    "tanstack-query",
    "sqlite",
    "opfs",
    "eas",
    "arweave"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && vite build",
    "test": "cd ../.. && vitest run --reporter=default --config vite.config.js --project=browser-react",
    "test:watch": "cd ../.. && vitest --config vite.config.js --project=browser-react",
    "test:browser": "cd ../.. && vitest --config vite.config.js --project=browser"
  },
  "peerDependencies": {
    "@seedprotocol/sdk": "workspace:*",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "@tanstack/react-query": "^5"
  },
  "dependencies": {
    "debug": "^4.4.1",
    "drizzle-orm": "^0.44.3",
    "lodash-es": "^4.17.22",
    "pluralize": "^8.0.0",
    "rxjs": "^7.8.1",
    "xstate": "^5.28.0"
  },
  "devDependencies": {
    "@seedprotocol/sdk": "workspace:*",
    "vite-plugin-dts": "^4.5.4",
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JournoLabs/seed-protocol-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/JournoLabs/seed-protocol-sdk/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/JournoLabs/seed-protocol-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
