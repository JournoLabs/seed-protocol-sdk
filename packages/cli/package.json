{
  "name": "@seedprotocol/cli",
  "version": "0.5.1",
  "private": true,
  "description": "Experimental — not supported; do not depend on or publish. CLI tool for Seed Protocol.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "cli": "./dist/bin.js",
    "seed": "./dist/bin.js",
    "seed-init": "./dist/bin.js",
    "seed-add-model": "./dist/addModel.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 20 <= 24"
  },
  "scripts": {
    "build": "tsc && rollup -c",
    "dev": "tsx src/bin.ts",
    "dev:init": "tsx src/bin.ts init",
    "dev:export-sql": "tsx src/bin.ts export-sql",
    "dev:seed": "tsx src/bin.ts seed",
    "dev:feed-publish": "tsx src/bin.ts feed publish",
    "dev:feed-seed": "tsx src/bin.ts feed seed",
    "dev:feed-serve": "tsx src/bin.ts feed serve",
    "dev:gateway-serve": "tsx src/bin.ts gateway tunnel serve",
    "dev:gateway-connect": "tsx src/bin.ts gateway tunnel connect"
  },
  "dependencies": {
    "@seedprotocol/feed-hyper": "workspace:*",
    "@seedprotocol/gateway-hyper": "workspace:*",
    "@seedprotocol/sdk": "workspace:*",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.44.3",
    "rimraf": "^6.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup": "^4.29.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-preserve-shebang": "^1.0.1",
    "typescript": "~5.7.2"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT"
}
