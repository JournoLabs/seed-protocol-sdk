{
  "name": "@seedprotocol/vite",
  "version": "0.8.0",
  "description": "Vite plugin for browser apps using @seedprotocol/sdk: cross-origin isolation headers, ES module workers, linked-install support, and opt-in Node polyfills",
  "keywords": [
    "seed-protocol",
    "vite",
    "vite-plugin",
    "zenfs",
    "opfs",
    "sqlite-wasm",
    "cross-origin-isolation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && vite build && node ../../scripts/fix-dts-specifiers.js",
    "test": "vitest run --reporter=default && node ../../scripts/check-browser-entry-graph.js --fail",
    "prepublishOnly": "bun run build && node ../../scripts/sync-versions.js"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.1.0",
    "vite-plugin-node-polyfills": "^0.27.0"
  },
  "peerDependencies": {
    "@zenfs/core": "^2.7.7",
    "@zenfs/dom": "^1.2.14",
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@zenfs/core": {
      "optional": true
    },
    "@zenfs/dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@seedprotocol/bundler-core": "workspace:*",
    "@types/bun": "1.4.3",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JournoLabs/seed-protocol-sdk.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/JournoLabs/seed-protocol-sdk/tree/main/packages/vite#readme",
  "bugs": {
    "url": "https://github.com/JournoLabs/seed-protocol-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
