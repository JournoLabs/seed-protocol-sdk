{
  "name": "@seedprotocol/feed-hyper",
  "version": "0.5.0",
  "description": "Hyperdrive / Hyperswarm distribution for Seed Protocol feeds",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && vite build",
    "test": "vitest run --reporter=default",
    "prepublishOnly": "bun run build && node ../../scripts/sync-versions.js"
  },
  "dependencies": {
    "@seedprotocol/arweave": "workspace:*",
    "@seedprotocol/feed": "workspace:*",
    "corestore": "^7.12.0",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdrive": "^13.0.0",
    "hyperswarm": "^4.14.0",
    "pluralize": "^8.0.0",
    "serve-drive": "^5.2.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pluralize": "^0.0.33",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
