{
  "name": "@seedprotocol/query",
  "version": "0.7.12",
  "description": "Read canonical Seed Protocol JSON (seeds, collections, changelogs) from EAS attestations or a local SQLite source, with memory and disk caching",
  "keywords": [
    "seed-protocol",
    "eas",
    "ethereum-attestation-service",
    "attestations",
    "query",
    "arweave",
    "sqlite",
    "web3"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "main": "./dist/index.node.js",
  "types": "./dist/index.node.d.ts",
  "browser": "./dist/index.js",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "require": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && vite build && node ../../scripts/fix-dts-specifiers.js",
    "test": "vitest run --reporter=default",
    "prepublishOnly": "bun run build && node ../../scripts/sync-versions.js"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@seedprotocol/arweave": "workspace:*",
    "@seedprotocol/eas": "workspace:*",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/pluralize": "^0.0.33",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JournoLabs/seed-protocol-sdk.git",
    "directory": "packages/query"
  },
  "homepage": "https://github.com/JournoLabs/seed-protocol-sdk/tree/main/packages/query#readme",
  "bugs": {
    "url": "https://github.com/JournoLabs/seed-protocol-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
