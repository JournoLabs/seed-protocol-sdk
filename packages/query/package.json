{
  "name": "@seedprotocol/query",
  "version": "0.5.1",
  "description": "Canonical Seed JSON query (remote EAS + local SQLite adapters) for Seed Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && vite build",
    "test": "vitest run --reporter=default",
    "prepublishOnly": "bun run build && node ../../scripts/sync-versions.js"
  },
  "dependencies": {
    "@seedprotocol/arweave": "workspace:*",
    "@seedprotocol/eas": "workspace:*",
    "graphql-request": "^7.3.5",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pluralize": "^0.0.33",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
