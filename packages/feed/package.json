{
  "name": "@seedprotocol/feed",
  "version": "0.7.7",
  "description": "RSS 2.0, Atom and JSON Feed generation for Seed Protocol items, with HTTP handlers, ETag caching and RFC 5005 archives",
  "keywords": [
    "seed-protocol",
    "rss",
    "atom",
    "json-feed",
    "feed",
    "syndication",
    "eas",
    "arweave"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && vite build",
    "prepublishOnly": "bun run build && node ../../scripts/sync-versions.js"
  },
  "dependencies": {
    "@seedprotocol/arweave": "workspace:*",
    "@seedprotocol/eas": "workspace:*",
    "@seedprotocol/query": "workspace:*",
    "express": "^5.2.1",
    "feedsmith": "^2.9.0",
    "graphql-request": "^7.3.5",
    "image-size": "^1.1.1",
    "pluralize": "^8.0.0",
    "rss-parser": "^3.13.0",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JournoLabs/seed-protocol-sdk.git",
    "directory": "packages/feed"
  },
  "homepage": "https://github.com/JournoLabs/seed-protocol-sdk/tree/main/packages/feed#readme",
  "bugs": {
    "url": "https://github.com/JournoLabs/seed-protocol-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
