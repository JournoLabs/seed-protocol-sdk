{
  "name": "@seedprotocol/licensing",
  "version": "0.8.1",
  "description": "License terms, catalog and deeds for Seed Protocol",
  "keywords": [
    "seed-protocol",
    "license",
    "spdx",
    "creative-commons",
    "odrl"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./catalog/cc": {
      "import": {
        "types": "./dist/catalog/cc/index.d.ts",
        "default": "./dist/catalog/cc.js"
      },
      "require": {
        "types": "./dist/catalog/cc/index.d.ts",
        "default": "./dist/catalog/cc.js"
      }
    },
    "./terms.schema.json": "./terms.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "terms.schema.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && vite build && node ../../scripts/fix-dts-specifiers.js",
    "test": "vitest run --reporter=default"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ajv": "^8.17.1",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "author": "Keith Axline <keith@journodao.xyz>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JournoLabs/seed-protocol-sdk.git",
    "directory": "packages/licensing"
  },
  "homepage": "https://github.com/JournoLabs/seed-protocol-sdk/tree/main/packages/licensing#readme",
  "bugs": {
    "url": "https://github.com/JournoLabs/seed-protocol-sdk/issues"
  }
}
