// Unused files, exports and dependencies. scripts/check-knip.js fails when a count rises above
// scripts/knip-baseline.json. Entries are each package's build inputs (vite/rollup `entry`,
// which back its package.json `exports` and `bin`), its tests and its test setup files.
// Every ignore says why.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exports a file uses itself are not dead code.
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // drizzle reads the schema as a namespace (`import * as schema`): relations must be exported,
    // and each table's row types sit beside it.
    "packages/sdk/src/seedSchema/*.ts": ["exports", "types"]
  },
  // System binary, called by archive's metadata test when installed.
  "ignoreBinaries": ["xmllint"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{js,ts,mjs}", "vite.config.js"],
      "project": ["scripts/**/*.{js,ts,mjs}"]
    },
    "packages/archive": {
      "entry": ["src/index.ts", "src/node/index.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"]
    },
    "packages/arweave": {
      "entry": ["src/index.ts", "src/node/index.ts", "codegen.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"],
      // Generated by graphql-codegen.
      "ignore": ["src/graphql/gql/**"],
      // codegen.ts names the plugin as 'introspection'.
      "ignoreDependencies": ["@graphql-codegen/introspection"]
    },
    "packages/bundler-core": {
      "entry": ["src/index.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"]
    },
    "packages/eas": {
      "entry": [
        "src/index.ts",
        "src/node/index.ts",
        "codegen.ts",
        // graphql-codegen reads these fragments; queries.ts spreads them by name.
        "src/graphql/fragments/*.ts",
        "__tests__/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"],
      // Generated by graphql-codegen.
      "ignore": ["src/graphql/gql/**"]
    },
    "packages/feed": {
      "entry": ["src/index.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"]
    },
    "packages/feed-hyper": {
      "entry": ["src/index.ts", "src/bin.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"]
    },
    "packages/gateway-hyper": {
      "entry": ["src/index.ts", "src/bin.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"]
    },
    "packages/mapping": {
      "entry": ["src/index.ts", "src/react.ts", "__tests__/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "__tests__/**/*.{ts,tsx}"]
    },
    "packages/next": {
      "entry": ["src/index.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"]
    },
    "packages/publish": {
      "entry": ["src/index.ts", "src/thirdweb.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test-utils/**/*.ts"]
    },
    "packages/query": {
      "entry": ["src/index.ts", "src/index.node.ts", "src/node/index.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"]
    },
    "packages/react": {
      "entry": [
        "src/index.ts",
        "__tests__/**/*.test.{ts,tsx}",
        "__tests__/setup.browser.ts",
        // Loaded by __tests__/react-app/index.html.
        "__tests__/react-app/src/main.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}", "__tests__/**/*.{ts,tsx}"]
    },
    "packages/sdk": {
      "entry": [
        "src/index.ts",
        "src/node/index.ts",
        "src/vite/index.ts",
        "src/drizzle/index.ts",
        "src/platform/index.ts",
        "src/platform/index.node.ts",
        "src/platform/index.browser.ts",
        "src/node/easLodashRegister.js",
        // drizzle-kit config (bun run drizzle:update).
        "src/db/configs/migrations.config.ts",
        "scripts/*.{ts,mjs}",
        "__tests__/**/*.test.{ts,tsx}",
        "__tests__/setup.browser.ts",
        "__tests__/globalSetup.node.ts",
        "__tests__/test-utils/noUnloadGrace.ts",
        // Type tests, compiled by tsconfig.typetests.json.
        "__tests__/types/**/*.ts",
        // Loaded by __tests__/e2e/multiTab/tab.html.
        "__tests__/e2e/multiTab/tab.ts",
        // Scripts run by hand (see their headers).
        "__tests__/test-utils/generate-fixture-files.ts",
        "__tests__/Schema/debug-schema-models.ts"
      ],
      "project": ["src/**/*.{ts,tsx,js}", "__tests__/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"],
      // Generated: drizzle-kit migrations and their embedded copy (bun run drizzle:update).
      "ignore": ["src/db/drizzle/**", "src/browser/db/drizzleFiles.ts"]
    },
    "packages/vite": {
      "entry": [
        "src/index.ts",
        "__tests__/**/*.test.ts",
        // Consumer apps the integration tests serve.
        "__tests__/fixtures/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"]
    }
  }
}
