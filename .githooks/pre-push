#!/bin/sh
# Opt-in pre-push hook: the two cheap, deterministic checks from the Release workflow's
# "Lint and test" job. Install with `git config core.hooksPath .githooks`; skip once with
# `git push --no-verify`. The full job is `bun run ci:local`.
set -e

echo "pre-push: checking bun.lock is in sync (bun install --frozen-lockfile --dry-run)"
if ! out="$(bun install --frozen-lockfile --dry-run 2>&1)"; then
  printf '%s\n' "$out" | tail -n 5
  echo "pre-push: bun.lock is out of date. Run \`bun install\` and commit bun.lock." >&2
  exit 1
fi

echo "pre-push: bun run lint"
bun run lint --quiet
